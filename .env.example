# ─────────────────────────────────────────────────────────────────────────────
# Copia este archivo a `.env` y completa los valores. `.env` esta gitignoreado.
# NADA de esto se commitea.
# ─────────────────────────────────────────────────────────────────────────────

# ── OBLIGATORIO: token ───────────────────────────────────────────────────────
# System User token con los scopes: instagram_basic, instagram_manage_comments,
# pages_messaging, instagram_manage_messages.
# Sin esto no corre ni la verificacion de acceso (01).
META_TOKEN_MARKETING_INTEGRATION=

# ── OBLIGATORIO: que reel ────────────────────────────────────────────────────
# El shortcode es el tramo final del permalink:
#   https://www.instagram.com/reel/DYa0FHhR-s5/  ->  DYa0FHhR-s5
REEL_SHORTCODE=

# Handle de IG de Cinthya SIN @ (ej: cinthya.something).
# Se usa para (a) encontrar su pagina en el BM y (b) detectar sus respuestas.
IG_USERNAME=

# ── OBLIGATORIO: la palabra clave del trigger ────────────────────────────────
# El keyword que la gente comento para disparar la automatizacion (ej: 30x).
# Solo se le manda DM a quien lo comento.
TRIGGER_KEYWORD=

# ── OBLIGATORIO: la tarjeta del DM ───────────────────────────────────────────
# Copiar del flow original de ManyChat para que el mensaje sea identico al que
# debieron recibir. Si no hay acceso a ManyChat, pedir el copy al owner del flow.
CARD_TITLE=
CARD_BUTTON_TITLE=
CARD_BUTTON_URL=

# ── Deteccion de "ya procesado" ──────────────────────────────────────────────
# Frases de la respuesta publica de ManyChat, separadas por `|`.
# Un comentario con respuesta del owner que matchee alguna = ya lo proceso
# ManyChat = NO se le manda DM. Sacar de `feed_comment_welcome.public_reply_messages`
# del flow, o mirando a mano las respuestas en el reel.
PUBLIC_REPLY_PHRASES=te acabo de enviar|revisa tu dm|te lo mande por dm|listo, te escribi

# ── Ritmo de envio ───────────────────────────────────────────────────────────
# Meta topea private_replies en ~200/hora. 18000ms = 200/hora exactos.
# NO bajar esto sin entender el riesgo: pasarse dispara #613 y, sostenido,
# arriesga un limite sobre la cuenta.
SEND_INTERVAL_MS=18000

# Margen de seguridad sobre la ventana de 7 dias (en horas). Un comentario que
# expira dentro de este margen se descarta en vez de gastarle un intento.
WINDOW_SAFETY_HOURS=2

# ── Atribucion ───────────────────────────────────────────────────────────────
# `true` reescribe utm_medium a `ig_dm_recovery` para separar la cohorte de
# recuperacion de la organica en HubSpot. `false` deja la URL tal cual.
REWRITE_UTM_MEDIUM=true
UTM_MEDIUM_RECOVERY=ig_dm_recovery

# ── Avanzado ─────────────────────────────────────────────────────────────────
GRAPH_VERSION=v23.0

# ── Respuesta publica en el hilo (paso 9) ────────────────────────────────────
# Lo otro que hace ManyChat: el comentario del owner debajo del de la persona.
# Solo se responde a quien YA recibio el DM. Textos rotativos separados por `|`.
# Escribilos para que matcheen PUBLIC_REPLY_PHRASES: asi, si alguien vuelve a
# correr el paso 3, nuestras respuestas cuentan como "ya procesado".
PUBLIC_REPLY_TEXTS=Listo, te acabo de enviar el recurso por DM 📩|Ya te lo mandé por DM, revisa tu bandeja 🙌|Listo, te escribí por DM con el acceso ✅

# 1 por minuto. Mas lento que los DMs A PROPOSITO: son N comentarios del owner
# en un mismo hilo desde la API, el patron que castiga el filtro de spam de Meta
# (y el costo es un limite sobre la cuenta, no un 400). Minimo aceptado: 18000.
PUBLIC_REPLY_INTERVAL_MS=60000

# ─────────────────────────────────────────────────────────────────────────────
# MODO EN VIVO (reemplazo de ManyChat) — nada de esto hace falta para los
# scripts 01..09 ni para la recuperacion manual. Es para que la herramienta
# mande los DMs sola, 24/7, apenas alguien comenta la palabra clave.
# ─────────────────────────────────────────────────────────────────────────────

# El MISMO System User token de arriba, pero leido por el modo en vivo. En
# produccion lo inyecta Secret Manager (secreto `meta-system-user-token`); en
# local podes dejarlo vacio: cae a META_TOKEN_MARKETING_INTEGRATION.
# SIN ESTO el modo en vivo queda apagado (la UI lo explica).
META_SYSTEM_USER_TOKEN=

# App Secret de la app de Meta ("PreWave Comentarios"), para verificar la firma
# de los webhooks. developers.facebook.com -> App settings -> Basic -> Show.
# Vacio o "unset" = webhook apagado: POST /webhooks/meta responde 503 y la
# deteccion queda solo por sondeo (<=20 s). Nadie puede dispararnos DMs sin el.
META_APP_SECRET=

# Cadena inventada por nosotros, la misma que se pega en el dashboard de Meta
# al configurar el webhook. Solo sirve para el handshake GET.
META_WEBHOOK_VERIFY_TOKEN=

# Interruptor general. `false` = no sondea ni envia nada (las automatizaciones
# se siguen viendo). Default: activo si hay token.
LIVE_ENABLED=true

# Cada cuanto se le pregunta a Meta por comentarios nuevos, por automatizacion
# activa. Minimo 10000. Mas seguido no sirve: para instantaneo esta el webhook.
LIVE_POLL_INTERVAL_MS=20000

# Ritmo de salida, iguales a los de la recuperacion y con los mismos pisos:
# 18000 ms = 200 DMs/hora (el tope de Meta). Por debajo, el server NO arranca.
LIVE_SEND_INTERVAL_MS=18000
LIVE_REPLY_INTERVAL_MS=60000

# Margen sobre la ventana de 7 dias, igual que WINDOW_SAFETY_HOURS.
LIVE_WINDOW_SAFETY_HOURS=2
