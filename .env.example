# ─────────────────────────────────────────────────────────────────────────────
# Two consumers read this file:
#   - `supabase functions serve --env-file .env` (local Edge Functions)
#   - `supabase secrets set --env-file .env`     (production Edge Functions)
#   - the CLI scripts in src/01..09 (single-token, local use)
# In production, Edge Functions get SUPABASE_URL / SUPABASE_ANON_KEY /
# SUPABASE_SERVICE_ROLE_KEY injected automatically: never set those as secrets.
# ─────────────────────────────────────────────────────────────────────────────

# ── REQUIRED: encryption key for every user's Meta token ─────────────────────
# 32 bytes hex. Rotating it makes every stored token unreadable (users paste
# theirs again). Generate with:  openssl rand -hex 32
TOKEN_ENCRYPTION_KEY=

# ── REQUIRED: shared secret between pg_cron and the worker functions ─────────
# Any random string. The same value goes into Vault as `worker_secret`.
WORKER_SECRET=

# ── Login allowlists (optional). Empty = any verified email can sign up ─────
AUTH_ALLOWED_DOMAINS=
AUTH_ALLOWED_EMAILS=

# ── Meta app (for the webhook; optional, polling covers everything) ──────────
# App Secret of YOUR Meta app. Empty or "unset" = webhook off (503).
META_APP_SECRET=
# Any string you invent; paste the same in the Meta dashboard webhook config.
META_WEBHOOK_VERIFY_TOKEN=

# ── Live mode ────────────────────────────────────────────────────────────────
LIVE_ENABLED=true
LIVE_POLL_INTERVAL_MS=20000
LIVE_SEND_INTERVAL_MS=18000
LIVE_REPLY_INTERVAL_MS=60000
LIVE_WINDOW_SAFETY_HOURS=2
GRAPH_VERSION=v23.0

# ─────────────────────────────────────────────────────────────────────────────
# CLI scripts (src/01..09) — single-token, local use only. Not used by the app.
# ─────────────────────────────────────────────────────────────────────────────
META_TOKEN_MARKETING_INTEGRATION=
REEL_SHORTCODE=
IG_USERNAME=
TRIGGER_KEYWORD=
CARD_TITLE=
CARD_BUTTON_TITLE=
CARD_BUTTON_URL=
PUBLIC_REPLY_PHRASES=te acabo de enviar|revisa tu dm|te lo mande por dm|listo, te escribi
SEND_INTERVAL_MS=18000
WINDOW_SAFETY_HOURS=2
REWRITE_UTM_MEDIUM=true
UTM_MEDIUM_RECOVERY=ig_dm_recovery
PUBLIC_REPLY_TEXTS=Listo, te acabo de enviar el recurso por DM 📩|Ya te lo mandé por DM, revisa tu bandeja 🙌|Listo, te escribí por DM con el acceso ✅
PUBLIC_REPLY_INTERVAL_MS=60000
